# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง (ดูได้จาก Vercel → Settings → Environment Variables)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require&channel_binding=require"
NEXTAUTH_SECRET="your-secret-here"
AUTH_SECRET="your-secret-here"
NEXTAUTH_URL="http://localhost:3000"
CRON_SECRET="your-cron-secret"
AUTH_TRUST_HOST=true

# Google sign-in — from Google Cloud Console > Credentials > OAuth client ID
# Authorized redirect URIs must include:
#   http://localhost:3000/api/auth/callback/google
#   https://<your-domain>/api/auth/callback/google
AUTH_GOOGLE_ID="xxxxx.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="GOCSPX-xxxxx"

# Gmail delivery for the generated-password welcome mail.
# GMAIL_APP_PASSWORD is a 16-character App Password (needs 2-Step Verification):
#   https://myaccount.google.com/apppasswords
# Leave both blank to skip e-mail — the in-app notification still works.
GMAIL_USER="you@gmail.com"
GMAIL_APP_PASSWORD="xxxxxxxxxxxxxxxx"

# Base URL used for links inside e-mails. Optional on Vercel (falls back to
# VERCEL_PROJECT_PRODUCTION_URL); set it if you use a custom domain.
APP_URL="https://rental-web-ten.vercel.app"
